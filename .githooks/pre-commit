#!/bin/sh
# The format and lint gates CI enforces, before the commit rather than after
# the push. Typecheck and tests run in pre-push, not here.
#
# Both keep a cache under node_modules/.cache and re-check only files whose
# content changed. Lint uses type information, so an edit to one file can
# change the verdict on another that the cache skips; CI lints a clean
# checkout without a cache and catches that.

npm run --silent format:check -- --cache &&
  npm run --silent lint -- --cache --cache-strategy content --cache-location node_modules/.cache/eslint/
