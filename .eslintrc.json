{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended-type-checked",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:react/jsx-runtime",
    // Last, so it wins: it switches off the stylistic rules prettier already
    // decides and turns a formatting difference into a lint error. This used
    // to live in a second config under src/, which meant the rules the repo
    // actually ran on its own source were not the ones written here.
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": [
      "./tsconfig.server.json",
      "./tsconfig.client.json",
      "./bench/tsconfig.json",
      "./tools/tsconfig.json",
      "./e2e/tsconfig.json"
    ],
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react",
    "react-hooks",
    "@typescript-eslint",
    "prettier"
  ],
  "settings": {
    "react": { "version": "detect" }
  },
  "rules": {
    "react/prop-types": "off",
    // Same seams as the no-unsafe family below, one step earlier: the type
    // that says `any` out loud is usually the one at the wire, the sandbox or
    // a JSON file, where writing it down beats pretending. The unsafe *uses*
    // of it still warn, which is where a real mistake shows. src/ had this off
    // through its own config for as long as the rule has existed here; it is
    // written once now, and it applies to the benchmarks and tools too.
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // A promise handed to a JSX attribute is a browser-side unhandled
    // rejection: the click silently does nothing. A promise handed to an
    // Express handler took the whole process down before createRouter (see
    // app.ts). Only the second is worth failing the build over, and every
    // `onClick={async ...}` here already try/catches to set its own error
    // state.
    "@typescript-eslint/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    // The engine talks to three untyped worlds - the wire, the sandbox, and
    // JSON on disk - so `any` legitimately crosses those seams. The count is
    // zero today: every crossing casts once, at the seam, to the type the rest
    // of the code already declares (WsServerMessage for the inbound decoder,
    // HttpError for a rejected fetch). Warn rather than error because the next
    // seam is a boundary doing its job, not a defect - it just has to be
    // deliberate. Raise these to "error" once that stops being a live tension.
    "@typescript-eslint/no-unsafe-argument": "warn",
    "@typescript-eslint/no-unsafe-assignment": "warn",
    "@typescript-eslint/no-unsafe-member-access": "warn",
    "@typescript-eslint/no-unsafe-return": "warn",
    "@typescript-eslint/no-unsafe-call": "warn",
    // An async function that never awaits is a signature that drifted, not a
    // defect: awaiting it still works. None are left - the tick path is
    // synchronous (a hit resolves inside the tick that caused it, not a
    // microtask later) and the stubs that owe a caller a promise return
    // `Promise.resolve` instead of pretending to await.
    // await-thenable stays an error - that one is the caller being wrong.
    "@typescript-eslint/require-await": "warn"
  },
  "overrides": [
    {
      "files": ["src/server/**/*.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      // Handlers here are registered on a createRouter() router, which catches
      // a returned promise and forwards the rejection to the error middleware
      // (see app.ts). Express's own types still declare the handler as
      // void-returning and cannot express that, so the rule reads every async
      // route as a dropped promise. The relaxation stops at the files that
      // register on such a router: the routes directory, and createRouter's
      // own test.
      "files": ["src/server/http/routes/**/*.ts", "src/server/app.test.ts"],
      "rules": {
        "@typescript-eslint/no-misused-promises": [
          "error",
          { "checksVoidReturn": { "attributes": false, "arguments": false } }
        ]
      }
    },
    {
      // A test reads an HTTP body, a KV document or a sandbox return value as
      // the untyped thing it is on the wire; asserting on `res.body.error` is
      // the test doing its job, not a seam to tighten.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "@typescript-eslint/no-unsafe-argument": "off",
        "@typescript-eslint/no-unsafe-assignment": "off",
        "@typescript-eslint/no-unsafe-member-access": "off",
        "@typescript-eslint/no-unsafe-return": "off",
        "@typescript-eslint/no-unsafe-call": "off",
        "@typescript-eslint/unbound-method": "off"
      }
    },
    {
      // Sandboxed code has no tsconfig by design (it is loaded, not compiled),
      // so the type-aware rules have nothing to read and would error on every
      // file.
      "files": ["modules/**/server.js", "scripts/**/*.js"],
      "extends": ["plugin:@typescript-eslint/disable-type-checked"],
      "parserOptions": {
        "project": null,
        "sourceType": "script"
      },
      "env": {
        "browser": false,
        "node": false,
        "es2022": true
      },
      "globals": {
        "on": "readonly",
        "attach": "readonly",
        "config": "readonly",
        "getPlayer": "readonly",
        "getPlayers": "readonly",
        "getNearbyNpcs": "readonly",
        "getSpells": "readonly",
        "createSpells": "readonly",
        "getDialog": "readonly",
        "getQuests": "readonly",
        "getRecipes": "readonly",
        "getArrow": "readonly",
        "getArrows": "readonly",
        "getItem": "readonly",
        "getMapSize": "readonly",
        "getMapTile": "readonly",
        "getMapPvp": "readonly",
        "spawnNpc": "readonly",
        "despawnNpc": "readonly",
        "moveNpcToward": "readonly",
        "TILE_SIZE": "readonly",
        "giveItem": "readonly",
        "removeItem": "readonly",
        "hasItem": "readonly",
        "countItem": "readonly",
        "canCarry": "readonly",
        "moveItem": "readonly",
        "exchangeItems": "readonly",
        "coroutine": "readonly",
        "wait": "readonly",
        "waitFor": "readonly",
        "persistNow": "readonly",
        "delivery": "readonly",
        "Items": "readonly",
        "Npcs": "readonly",
        "Maps": "readonly",
        "Spells": "readonly",
        "Arrows": "readonly",
        "healPlayer": "readonly",
        "killPlayer": "readonly",
        "dealDamage": "readonly",
        "giveExperience": "readonly",
        "setNameColor": "readonly",
        "setNameTag": "readonly",
        "setCosmetic": "readonly",
        "clearCosmetic": "readonly",
        "getPlayerData": "readonly",
        "setPlayerData": "readonly",
        "store": "readonly",
        "flags": "readonly",
        "teleportPlayer": "readonly",
        "sendMessage": "readonly",
        "broadcastMessage": "readonly",
        "sendEvent": "readonly",
        "sendMapEvent": "readonly",
        "broadcastEvent": "readonly",
        "httpRequest": "readonly",
        "provide": "readonly",
        "use": "readonly",
        "Access": "readonly",
        "command": "readonly",
        "after": "readonly",
        "every": "readonly",
        "cancel": "readonly",
        "msToTicks": "readonly",
        "TICK_RATE": "readonly",
        "random": "readonly",
        "randomInt": "readonly",
        "randomChance": "readonly",
        "randomPick": "readonly",
        "setTimeout": "readonly",
        "setInterval": "readonly",
        "clearInterval": "readonly",
        "log": "readonly",
        "warn": "readonly",
        "error": "readonly"
      },
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["modules/**/client.js"],
      "extends": ["plugin:@typescript-eslint/disable-type-checked"],
      "parserOptions": {
        "project": null,
        "sourceType": "script"
      },
      "env": {
        "browser": true,
        "node": false,
        "es2022": true
      },
      "globals": {
        "engine": "readonly"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "*.cjs",
    "bundle.js",
    "src/server/model/seed.ts"
  ]
}
