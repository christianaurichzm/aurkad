{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:react/jsx-runtime"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react",
    "react-hooks",
    "@typescript-eslint"
  ],
  "settings": {
    "react": { "version": "detect" }
  },
  "rules": {
    "react/prop-types": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/server/**/*.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["modules/**/server.js", "scripts/**/*.js"],
      "parserOptions": {
        "project": null,
        "sourceType": "script"
      },
      "env": {
        "browser": false,
        "node": false,
        "es2022": true
      },
      "globals": {
        "on": "readonly",
        "attach": "readonly",
        "config": "readonly",
        "getPlayer": "readonly",
        "getPlayers": "readonly",
        "getNearbyNpcs": "readonly",
        "getSpells": "readonly",
        "createSpells": "readonly",
        "getArrow": "readonly",
        "getArrows": "readonly",
        "getItem": "readonly",
        "getMapSize": "readonly",
        "getMapTile": "readonly",
        "getMapPvp": "readonly",
        "spawnNpc": "readonly",
        "despawnNpc": "readonly",
        "moveNpcToward": "readonly",
        "TILE_SIZE": "readonly",
        "giveItem": "readonly",
        "removeItem": "readonly",
        "hasItem": "readonly",
        "countItem": "readonly",
        "canCarry": "readonly",
        "moveItem": "readonly",
        "persistNow": "readonly",
        "delivery": "readonly",
        "Items": "readonly",
        "Npcs": "readonly",
        "Maps": "readonly",
        "Spells": "readonly",
        "Arrows": "readonly",
        "healPlayer": "readonly",
        "killPlayer": "readonly",
        "dealDamage": "readonly",
        "giveExperience": "readonly",
        "setNameColor": "readonly",
        "setNameTag": "readonly",
        "setCosmetic": "readonly",
        "clearCosmetic": "readonly",
        "getPlayerData": "readonly",
        "setPlayerData": "readonly",
        "store": "readonly",
        "teleportPlayer": "readonly",
        "sendMessage": "readonly",
        "broadcastMessage": "readonly",
        "sendEvent": "readonly",
        "sendMapEvent": "readonly",
        "broadcastEvent": "readonly",
        "provide": "readonly",
        "use": "readonly",
        "Access": "readonly",
        "command": "readonly",
        "after": "readonly",
        "every": "readonly",
        "cancel": "readonly",
        "msToTicks": "readonly",
        "TICK_RATE": "readonly",
        "random": "readonly",
        "randomInt": "readonly",
        "randomChance": "readonly",
        "randomPick": "readonly",
        "setTimeout": "readonly",
        "setInterval": "readonly",
        "clearInterval": "readonly",
        "log": "readonly",
        "warn": "readonly",
        "error": "readonly"
      },
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["modules/**/client.js"],
      "parserOptions": {
        "project": null,
        "sourceType": "script"
      },
      "env": {
        "browser": true,
        "node": false,
        "es2022": true
      },
      "globals": {
        "engine": "readonly"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "*.cjs",
    "bundle.js",
    "src/server/model/seed.ts"
  ]
}
