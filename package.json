{
  "name": "engine",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development nodemon --watch src/server --exec \"node --loader ts-node/esm src/server/server.ts\"",
    "dev:client": "cross-env NODE_ENV=development vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "cross-env NODE_ENV=production vite build",
    "build:server": "cross-env NODE_ENV=production tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist/server/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "fresh": "npm run db:reset && npm run build && npm start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "jsondiffpatch": "0.5.0",
    "mongoose": "^8.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.17.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/ui": "4.0.16",
    "concurrently": "^7.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.2",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.16"
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.41"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
