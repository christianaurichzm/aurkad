{
  "name": "aurkad",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Christian Aurich",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:server": "cross-env NODE_ENV=development node --watch-path=src/server --loader ts-node/esm src/server/server.ts",
    "dev:client": "cross-env NODE_ENV=development vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "cross-env NODE_ENV=production vite build",
    "build:server": "cross-env NODE_ENV=production tsc -p tsconfig.server.build.json",
    "build": "npm run build:client && npm run build:server",
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/server/server.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mongo",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "content:export": "node --loader ts-node/esm src/server/contentPack/cli.ts export",
    "content:import": "node --loader ts-node/esm src/server/contentPack/cli.ts import",
    "seed": "node --loader ts-node/esm src/server/model/seed.ts",
    "docs:api": "typedoc",
    "bench": "cross-env TS_NODE_PROJECT=bench/tsconfig.json node --loader ts-node/esm bench/benchNetcode.ts",
    "loadtest": "cross-env TS_NODE_PROJECT=bench/tsconfig.json node --loader ts-node/esm bench/loadTest.ts",
    "replay": "cross-env TS_NODE_PROJECT=tools/tsconfig.json node --loader ts-node/esm tools/replay.ts",
    "profile": "cross-env TS_NODE_PROJECT=tools/tsconfig.json node --loader ts-node/esm tools/profileServer.ts",
    "new-game": "cross-env TS_NODE_PROJECT=tsconfig.server.json node --loader ts-node/esm src/server/contentPack/newGame.ts",
    "dev:seed": "npm run db:reset && sleep 2 && npm run seed && npm run dev",
    "starter": "cross-env GAME_DIR=demos/starter npm run dev",
    "fresh": "npm run db:reset && npm run build && npm start",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && npm run typecheck:scripts && npm run typecheck:modules && npm run typecheck:bench && npm run typecheck:tools && npm run typecheck:e2e",
    "typecheck:bench": "tsc -p bench/tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p demos/starter/scripts/tsconfig.json --noEmit",
    "typecheck:modules": "tsc -p modules/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:production": "cross-env E2E_PRODUCTION=true playwright test",
    "lint": "eslint src bench tools e2e modules demos/starter/scripts",
    "format:check": "prettier --check \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.{js,jsx}\" \"demos/starter/scripts/*.js\"",
    "format:write": "prettier --write \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.{js,jsx}\" \"demos/starter/scripts/*.js\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.4",
    "nodemailer": "^10.0.14",
    "typescript": "~6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "jsondiffpatch": "^0.7.6",
    "monaco-editor": "^0.57.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.4.0",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^2.1.7"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
