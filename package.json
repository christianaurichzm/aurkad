{
  "name": "engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:server": "cross-env NODE_ENV=development nodemon --watch src/server --exec \"node --loader ts-node/esm src/server/server.ts\"",
    "dev:client": "cross-env NODE_ENV=development vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "predev": "fuser -k 8080/tcp 3000/tcp 2>/dev/null || true",
    "build:client": "cross-env NODE_ENV=production vite build",
    "build:server": "cross-env NODE_ENV=production tsc -p tsconfig.server.build.json",
    "build": "npm run build:client && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist/server/server.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mongo",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "content:export": "node --loader ts-node/esm src/server/content/cli.ts export",
    "content:import": "node --loader ts-node/esm src/server/content/cli.ts import",
    "seed": "node --loader ts-node/esm src/server/model/seed.ts",
    "bench": "cross-env TS_NODE_PROJECT=bench/tsconfig.json node --loader ts-node/esm bench/benchNetcode.ts",
    "loadtest": "cross-env TS_NODE_PROJECT=bench/tsconfig.json node --loader ts-node/esm bench/loadTest.ts",
    "replay": "cross-env TS_NODE_PROJECT=tools/tsconfig.json node --loader ts-node/esm tools/replay.ts",
    "profile": "cross-env TS_NODE_PROJECT=tools/tsconfig.json node --loader ts-node/esm tools/profileServer.ts",
    "dev:seed": "npm run db:reset && sleep 2 && npm run seed && npm run dev",
    "fresh": "npm run db:reset && npm run build && npm start",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && npm run typecheck:scripts && npm run typecheck:modules && npm run typecheck:bench && npm run typecheck:tools && npm run typecheck:e2e",
    "typecheck:bench": "tsc -p bench/tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:modules": "tsc -p modules/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "lint": "eslint src bench tools e2e modules scripts",
    "format:check": "prettier --check \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.js\" \"scripts/**/*.js\"",
    "format:write": "prettier --write \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.js\" \"scripts/**/*.js\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "monaco-editor": "^0.53.0",
    "mongoose": "^8.15.0",
    "nodemailer": "^9.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "ws": "^8.17.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.4",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.0",
    "concurrently": "^7.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "jsondiffpatch": "^0.7.6",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vite-plugin-monaco-editor-esm": "^2.0.2",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "^2.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
