{
  "name": "aurkad",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Christian Aurich",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:server": "cross-env NODE_ENV=development node --watch-path=src/server --import tsx src/server/server.ts",
    "dev:client": "cross-env NODE_ENV=development vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "cross-env NODE_ENV=production vite build",
    "build:server": "cross-env NODE_ENV=production tsc -p tsconfig.server.build.json",
    "build": "concurrently --group \"npm:build:client\" \"npm:build:server\"",
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/server/server.js",
    "db:up": "docker compose up -d --wait mongo",
    "db:reset": "docker compose down -v && docker compose up -d --wait mongo",
    "docker:up": "docker compose -f compose.game.yml -f compose.build.yml up -d --build",
    "docker:down": "docker compose -f compose.game.yml -f compose.build.yml down",
    "docker:logs": "docker compose -f compose.game.yml -f compose.build.yml logs -f app",
    "content:export": "node --import tsx src/server/contentPack/cli.ts export",
    "content:import": "node --import tsx src/server/contentPack/cli.ts import",
    "docs:api": "typedoc",
    "loadtest": "node --import tsx bench/loadTest.ts",
    "replay": "node --import tsx tools/replay.ts",
    "profile": "node --import tsx tools/profileServer.ts",
    "compat": "node --import tsx tools/compat.ts",
    "preversion": "npm run --silent compat -- --base v$npm_old_version --next $npm_new_version",
    "new-game": "node --import tsx src/server/contentPack/newGame.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run",
    "typecheck": "concurrently --group \"npm:typecheck:*\"",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/client.tsbuildinfo",
    "typecheck:bench": "tsc -p bench/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/bench.tsbuildinfo",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tools.tsbuildinfo",
    "typecheck:scripts": "tsc -p templates/new-game/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/scripts.tsbuildinfo",
    "typecheck:modules": "tsc -p modules/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/modules.tsbuildinfo",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/e2e.tsbuildinfo",
    "e2e": "playwright test",
    "e2e:production": "cross-env E2E_PRODUCTION=true playwright test",
    "lint": "eslint src bench tools e2e modules templates/new-game/game/scripts",
    "format:check": "prettier --check \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.{js,jsx}\" \"templates/new-game/game/scripts/*.js\"",
    "format:write": "prettier --write \"{src,bench,tools,e2e}/**/*.{ts,tsx}\" \"modules/**/*.{js,jsx}\" \"templates/new-game/game/scripts/*.js\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.4",
    "nodemailer": "^10.0.14",
    "typescript": "~6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "monaco-editor": "^0.57.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^2.1.7"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
