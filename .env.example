# Copy to .env and adjust. Used by docker-compose and local dev.

# MongoDB connection. With docker-compose, the host is the "mongo" service.
# The compose files run Mongo as a replica set, the only kind that writes two
# documents together, which is what makes a trade or a mailed item atomic;
# directConnection=true is how a container reaches its one member. The boot log
# says whether this server got transactions (see README).
# Without a database name in the URI, each GAME_DIR gets one named after its
# folder (`game` when GAME_DIR is unset); a name written here is used for any.
MONGO_URI=mongodb://mongo:27017/?directConnection=true

# Signs the session cookie. Unset, the first boot generates one and keeps it in
# the database, which every instance of the game then shares. Set it to keep
# the secret out of the database. Generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED by docker-compose: the user and group the server runs as, which must
# own the folders it mounts and writes to (scripts/, theme/). Yours: id -u, id -g
UID=1000
GID=1000

# REQUIRED in production. Comma-separated list of allowed origins for CORS,
# and of the pages that may open the game's WebSocket besides its own.
# Example: https://yourgame.com,https://www.yourgame.com
CORS_ALLOWED_ORIGINS=

# REQUIRED in production: the Secure flag on the session cookie, so a browser
# never sends it over plain http. The production boot refuses to start without
# it, because that cookie is the whole login and one request on a hostile
# network is somebody else's character. Put TLS in front (a proxy counts).
USE_SECURE_COOKIES=false

# Server port (container listens here; Caddy proxies to it in docker-compose).
PORT=8080

# Simulation tick rate in Hz (1-240).
TICK_RATE=20
# Catch-up ticks allowed per timer fire (spiral-of-death guard). Range 1-20;
# out-of-range values are clamped. Keep it small (2-5).
MAX_UPDATES_PER_TICK=5

# Tiles of margin around a player's viewport that still count as visible (0-20).
# Wider means entities are streamed in before they reach the edge of the screen,
# and more of them per update.
NET_AOI_MARGIN_TILES=2
# How many ticks apart one player's world updates are (1-4). 1 is every tick.
# Raising it is the lever on broadcast CPU, because the cost measured is per
# message rather than per byte: 2 halves the messages the server writes. The
# price is latency: the client learns about the world, including the server's
# correction of its own prediction, up to one tick later. So this is a call
# about how the game should feel, not a free win.
NET_VIEWER_CADENCE_TICKS=1

# The account registered with this username becomes admin, while the game has
# no admin yet (optional). Register it right after the first start.
BOOTSTRAP_ADMIN_USERNAME=

# Public WebSocket URL clients use when running multiple instances (sharding).
# Example: ws://your-host:8080  or  wss://your-host
WS_PUBLIC_URL=

# Comma-separated map IDs owned by this instance (multi-instance sharding).
# Leave empty to own all maps.
MAP_IDS=

# Setting WS_PUBLIC_URL + MAP_IDS together enables multi-instance mode. An
# account is leased to one instance at a time (the lease lives on the player
# document and every write is conditional on still holding it), so two
# instances cannot save the same character over each other. The lease is
# renewed on the heartbeat below and is worth three of them, which is also
# how long a crashed instance holds an account before it can log in elsewhere.
#
# What crosses instances: the account lease, global chat and broadcasts, MOTD,
# server mode, mutes, kicks/bans and live-ops flags, plus the online list (read
# from the leases). What does not: an operator command that needs the player's
# live character (pm, heal, kill, tp, warp) and the modules' own runtime state,
# so a party or a trade only forms between players on the same instance. The
# server names both at boot.

# How often an instance says it is alive: it refreshes its entry in the instance
# registry (which map lives where) and pushes the expiry of the accounts it
# holds. A lease is written for three beats, so this is also the tuning knob for
# how long a crashed instance keeps its players before they can log in
# elsewhere: three beats of 30s means at most a minute and a half.
# Clamped to 5000..300000.
INSTANCE_HEARTBEAT_MS=30000

# A folder holding the whole game: game.json, theme/, assets/, scripts/,
# content/ and any modules of its own, looked up there instead of in CWD, so
# switching games is this one variable. The official modules still come from
# the engine's modules/, and the game's load alongside them; one with an
# official module's id replaces it. Unset, all of it is read from CWD.
GAME_DIR=

# Absolute path to the assets directory (optional; GAME_DIR/assets, or CWD).
ASSETS_PATH=

# Absolute path to the content directory (optional; GAME_DIR/content, or CWD).
CONTENT_PATH=

# Absolute path to the official modules directory (optional, CWD/modules).
MODULES_PATH=

# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Session recording, for answering "what happened at 20:03". "true" starts a
# capture at boot; it is read only at boot, so during an incident use the admin
# command `replay start` instead, since restarting the server ends the session
# you wanted to look at.
REPLAY_RECORD=false

# How many client actions a recording holds. It is a ring: at the ceiling the
# oldest is dropped (and counted in the saved file), so a capture left running
# costs a bounded amount of memory. ~150 bytes per key action, more per chat
# line. Clamped to 100..5000000.
REPLAY_MAX_EVENTS=50000

# Where `replay save` writes. Recordings hold what players did and said, so
# treat the directory as player data; nothing is written until an operator asks.
# Defaults to replays/, or replays/<database>/ for a game run with GAME_DIR.
# REPLAY_DIR=replays

# Set to "true" to enable the Monaco script editor in the /admin dashboard.
# Saving a script here runs on the server with full host access (scripts are
# trusted code, not sandboxed; see engine/scripting/sandbox.ts). Enable only
# for operators you'd give shell access to.
SCRIPT_EDITOR_ENABLED=false

# Time budget for one script handler, and how many slow runs it gets before it
# stops running at all. Measured, not prevented: a handler that never returns
# cannot be interrupted from inside this process. A reload restores its budget.
SCRIPT_HANDLER_BUDGET_MS=8
SCRIPT_HANDLER_BUDGET_STRIKES=5

# The same measurement, added up instead of peaked. Over each window the cost
# of every script is summed and compared with wall-clock time; a script over
# the share gets one log line naming it and its worst handler. This is what
# catches the handler that is always just under the budget above, and the
# module that sweeps every player once a second. Also published per script and
# handler on /metrics (engine_script_handler_ms_total).
SCRIPT_TIME_WINDOW_MS=60000
SCRIPT_TIME_SHARE_WARN_PERCENT=10

# Vite client vars, only needed when serving the client from a different host
# than the API server. Leave unset for same-origin deployments (the default).
# VITE_APP_API_URL=your-api-host.com
# VITE_REST_PROTOCOL=https

# Login/register throttle, for both the game and the admin panel. Counted per
# session when there is one and per address before that, so this one is per
# address. The default is strict; raise it only for a local load-test run
# (npm run loadtest), never in production.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Ceiling for every other HTTP route, counted per logged-in player (or per
# address for anyone not logged in yet). Health probes answer before it and are
# never throttled. Generous by design: a player opening a map and its assets
# must never see a 429.
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=300

# REQUIRED behind a reverse proxy (nginx, Caddy, a cloud load balancer).
# Without it Express reports the proxy's address for every request, so all
# players share one rate-limit bucket and any one of them can lock out the
# rest. Set it to the NUMBER OF PROXIES in front of this server, or to the
# addresses to trust. `true` trusts any X-Forwarded-For, which lets a caller
# pick their own bucket; it works, and it warns at boot.
# TRUST_PROXY=1

# Player activity: who played, on which days, for how long. It is what answers
# "are people still here" and "did the newcomers stay": one row per player per
# day, read with the `analytics` command. Set to false to record nothing at all:
# this is the only store here that is about people rather than about the world,
# and it is also the switch to throw before `npm run loadtest`, because a
# thousand bots logging in are a thousand daily active players.
ANALYTICS_ENABLED=true

# How long those rows are kept, which is also how far back a report can look.
# The default holds a year of arrival cohorts plus the tail of the last one.
# Clamped to 30..3650.
ANALYTICS_RETENTION_DAYS=400

# Bearer token for GET /metrics, so Prometheus can scrape it: a scraper sends a
# header, it cannot log in and keep a session cookie. Unset means the endpoint
# is readable by an operator session only, which is a person with a browser and
# nobody else. Minimum 16 characters, and the boot refuses a shorter one.
#   openssl rand -hex 32
# In prometheus.yml:
#   authorization: { credentials: <this value> }
# METRICS_TOKEN=

# Where finished spans are posted, in OTLP over HTTP/JSON. Either the
# collector's base address (the /v1/traces path is appended) or the traces
# endpoint itself. Unset means no export: the trace ids are still minted and
# still appear on every log line as trace_id/span_id, which is what correlates
# a single-process deployment. A value that is not an http(s) URL fails the
# boot rather than quietly going nowhere.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=

# What the traces are labelled as. Two instances of one game share this name and
# tell themselves apart by WS_PUBLIC_URL, which is sent as service.instance.id.
OTEL_SERVICE_NAME=aurkad

# Percentage of new traces recorded, 0 to 100. A whole number, not the 0..1
# ratio the OTEL variable of a similar name takes: everything here is parsed
# and clamped as an integer, and a truncated 0.25 would be a sampler that
# records nothing. The decision is per trace and inherited by every hop, so a
# sampled trace is never half missing.
OTEL_TRACES_SAMPLE_PERCENT=100

# Bounds on data scripts persist (player.data and the shared store).
# maxValueBytes x maxKeys is the ceiling per player; the default 8MB leaves half
# of MongoDB's 16MB document limit for the rest of the character. Crossing that
# limit is unrecoverable: the save fails and retries forever.
SCRIPT_DATA_MAX_VALUE_BYTES=65536
SCRIPT_DATA_MAX_KEYS=128
KV_MAX_ENTRIES=100000

# How long the administrative trail (who kicked, banned, promoted, edited) is
# kept. MongoDB expires the entries itself, so the collection stays bounded
# without anyone pruning it. Minimum 1 day: the trail cannot be turned off.
AUDIT_RETENTION_DAYS=90

# Economy reconciliation: how often every item in the world is counted, how
# long the counts are kept, and when a growing total is worth a warning (a
# multiple AND an absolute floor, so a handful of new potions is not an alert).
ECONOMY_CENSUS_INTERVAL_MINUTES=60
ECONOMY_CENSUS_RETENTION_DAYS=30
ECONOMY_CENSUS_ALERT_GROWTH_PERCENT=100
ECONOMY_CENSUS_ALERT_MIN_CHANGE=100

# Where mail goes. `smtp` hands the message to the relay below and is the only
# one that reaches a player: with it, the login screen offers "forgot your
# password" and settings asks for the address to send it to. `log` writes the
# message to the server log instead, which is how a game with no mail account
# still resets a password: you read the line and hand the link over, or mint
# one directly with the `resetlink <username>` command. `none` drops it.
MAIL_TRANSPORT=log

# The relay, as one URL: smtps://user:pass@smtp.example.com for implicit TLS
# (port 465), or smtp://user:pass@smtp.example.com:587 for STARTTLS. Any mail
# host speaks this, including the SMTP endpoint of a sending API. To exercise
# the flow locally, run a catcher (Mailpit, MailHog) and point at it:
# SMTP_URL=smtp://localhost:1025 with MAIL_TRANSPORT=smtp.
# Required when MAIL_TRANSPORT=smtp, along with the sender address; relays
# refuse a From they have not authorised, so it has to be one of yours.
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=no-reply@example.com

# What a link in a message points at, with no trailing slash. Only you know the
# address your players type; the fallback is http://localhost:PORT, which is
# right in development and wrong everywhere else.
# PUBLIC_BASE_URL=https://play.example.com
