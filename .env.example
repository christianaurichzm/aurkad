# Copy to .env and adjust. Used by docker-compose and local dev.

# MongoDB connection. With docker-compose, the host is the "mongo" service.
MONGO_URI=mongodb://mongo:27017/game

# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# REQUIRED in production. Comma-separated list of allowed origins for CORS.
# Example: https://yourgame.com,https://www.yourgame.com
CORS_ALLOWED_ORIGINS=

# Set to "true" in production when the server is behind HTTPS/TLS.
# Enables the Secure flag on session cookies.
USE_SECURE_COOKIES=false

# Server port (container listens here; mapped to host in docker-compose).
PORT=8080

# Simulation tick rate (Hz) and per-tick update cap (optional).
TICK_RATE=20
MAX_UPDATES_PER_TICK=200

# First account with this username is granted admin access on register (optional).
BOOTSTRAP_ADMIN_USERNAME=

# Public WebSocket URL clients use when running multiple instances (sharding).
# Example: ws://your-host:8080  or  wss://your-host
WS_PUBLIC_URL=

# Comma-separated map IDs owned by this instance (multi-instance sharding).
# Leave empty to own all maps.
MAP_IDS=

# Base URL for serving images (optional, defaults to ".").
IMAGES_BASE_URL=

# Absolute path to the assets directory (optional, auto-detected from CWD).
ASSETS_PATH=

# Absolute path to the content directory (optional, auto-detected from CWD).
CONTENT_PATH=

# Absolute path to the modules directory (optional, auto-detected from CWD).
MODULES_PATH=

# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Set to "true" to enable game replay recording (writes replay files to disk).
REPLAY_RECORD=false

# Vite client vars, only needed when serving the client from a different host
# than the API server. Leave unset for same-origin deployments (the default).
# VITE_APP_API_URL=your-api-host.com
# VITE_REST_PROTOCOL=https
