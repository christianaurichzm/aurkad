{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/client/**/*",
    "src/test/**/*",
    "vite.config.ts",
    "vite.config.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
