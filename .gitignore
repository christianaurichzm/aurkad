# Dependencies, build output and tool caches
node_modules/
/dist/
/coverage/
.cache/
*.tsbuildinfo
.eslintcache
*.log

# .env is read by the compose files and .env.<NODE_ENV> by config.ts; all of
# them hold this machine's settings, secrets among them. .env.example
# documents every variable.
.env
.env.*
!.env.example

# This project installs with npm (README, CONTRIBUTING, CI and the Dockerfile
# all say so) and package-lock.json is the lockfile that gets validated. A
# second lockfile nobody reads drifts: it can stop listing Playwright, and a
# yarn install would then produce a tree the e2e suite cannot run on. Ignored
# so a stray `yarn install` cannot commit one.
yarn.lock

# Local seed script
src/server/model/seed.ts

# Generated per-project content constants (rebuilt at server boot)
scripts/content.generated.d.ts

# Games made inside the checkout: `npm run new-game` in the README's
# development steps, and the first `npm run docker:up`
/game/
/games/

# Playwright E2E run artifacts
/playwright-report/
/test-results/
/blob-report/

# Session recordings (`replay save`, REPLAY_RECORD). They hold what players did
# and said, so they are player data on the operator's disk, never a commit.
/replays/

# Generated API reference (npm run docs:api)
docs/api
